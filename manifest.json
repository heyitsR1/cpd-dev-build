{
  "manifest_version": 3,
  "default_locale": "en",
  "name": "Claude Project Downloader — Export, Folders & Chat Search",
  "description": "__MSG_extensionDescription__",
  "version": "1.20.0",
  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },
  "action": {
    "default_title": "Claude Project Downloader",
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "32": "assets/icons/icon-32.png",
      "48": "assets/icons/icon-48.png",
      "128": "assets/icons/icon-128.png"
    }
  },
  "permissions": [
    "activeTab",
    "alarms",
    "downloads",
    "offscreen",
    "storage",
    "scripting",
    "sidePanel"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "host_permissions": [
    "https://claude.ai/*"
  ],
  "externally_connectable": {
    "matches": ["https://claudeprojectdownloader.com/*"]
  },
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*"
      ],
      "js": [
        "lib/zip.js",
        "lib/chat-format.js",
        "lib/claude-api.js",
        "lib/i18n.js",
        "lib/usage.js",
        "lib/folders.js",
        "content/content.js",
        "content/chat-button.js",
        "content/usage-pill.js",
        "content/sidebar-folders.js",
        "lib/context-plan.js",
        "content/context-select.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "lib/zip.js"
      ],
      "matches": [
        "https://claude.ai/*"
      ]
    }
  ],
  "side_panel": {
    "default_path": "popup/popup.html"
  },
  "short_name": "Claude Project Downloader"
}
